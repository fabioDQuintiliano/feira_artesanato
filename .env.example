APP_ENV=development
APP_PORT=8080
APP_URL=http://localhost:8080/

# Codegen do painel (system/). Em production: 0 por padrão.
# SYSTEM_CODEGEN=1 força regeneração a cada request.
# SYSTEM_IDE_ENABLED=1 habilita rotas system-* (exceto system-rebuild, sempre liberado se autenticado).
# SYSTEM_AUX_BAR=1 mostra a barra auxiliar no adm/system.
# SYSTEM_CODEGEN=
# SYSTEM_IDE_ENABLED=
# SYSTEM_AUX_BAR=

DB_DATABASE=admin_feira
DB_USERNAME=feira
DB_PASSWORD=feira
DB_ROOT_PASSWORD=feira_root
DB_PORT_FORWARD=3307
PHPMYADMIN_PORT=8081

